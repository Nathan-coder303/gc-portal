generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  PM
  BOOKKEEPER
  PARTNER
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  EXPENSE
  REVENUE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  RESTORE
  IMPORT
  REVERSE
}

enum EntityType {
  EXPENSE
  COST_CODE
  TASK
  JOURNAL_ENTRY
  PARTNER
  ACCOUNT
  USER
  PROJECT
  PROJECT_SETTINGS
  ESTIMATE_TEMPLATE
  PROJECT_ESTIMATE
}

// ─── Core ────────────────────────────────────────────────────────────────────

model Company {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  createdAt         DateTime           @default(now())
  projects          Project[]
  users             User[]
  partners          Partner[]
  estimateTemplates EstimateTemplate[]
}

model Project {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id])
  name           String
  code           String?
  address        String?
  startDate      DateTime
  budget         Decimal          @db.Decimal(14, 2)
  status         String           @default("ACTIVE")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  updatedBy      String?
  expenses       Expense[]
  costCodes      CostCode[]
  tasks          Task[]
  accounts       Account[]
  journalEntries JournalEntry[]
  auditLogs      AuditLog[]
  settings       ProjectSettings[]
  estimates      ProjectEstimate[]
}

model User {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id])
  email        String    @unique
  name         String
  role         Role      @default(PM)
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  updatedBy    String?
  archivedAt   DateTime?
  archivedBy   String?
}

// ─── Expenses ────────────────────────────────────────────────────────────────

model CostCode {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id])
  code         String
  name         String
  budgetAmount Decimal   @default(0) @db.Decimal(14, 2)
  expenses     Expense[]
  updatedAt    DateTime  @updatedAt
  updatedBy    String?
  archivedAt   DateTime?
  archivedBy   String?

  @@unique([projectId, code])
}

model Expense {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  companyId     String
  date          DateTime  @db.Date
  vendor        String
  description   String
  costCodeId    String?
  costCode      CostCode? @relation(fields: [costCodeId], references: [id])
  category      String
  amount        Decimal   @db.Decimal(14, 2)
  tax           Decimal   @default(0) @db.Decimal(14, 2)
  paymentMethod String
  paidBy        String
  receiptUrl    String?
  receiptHash   String?
  notes         String?
  isPossibleDup Boolean   @default(false)
  isDuplicate   Boolean   @default(false)
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  updatedBy     String?
  archivedAt    DateTime?
  archivedBy    String?
}

// ─── Schedule ─────────────────────────────────────────────────────────────────

model Task {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id])
  phase           String
  name            String
  durationDays    Int
  startDate       DateTime?       @db.Date
  endDate         DateTime?       @db.Date
  predecessorIds  String[]
  trade           String?
  assignee        String?
  isMilestone     Boolean         @default(false)
  status          TaskStatus      @default(NOT_STARTED)
  percentComplete Int             @default(0)
  notes           String?
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  updatedBy       String?
  archivedAt      DateTime?
  archivedBy      String?
  changeLogs      TaskChangeLog[]
}

model TaskChangeLog {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  field     String
  oldValue  String?
  newValue  String?
  changedBy String
  changedAt DateTime @default(now())
}

// ─── Ledger ──────────────────────────────────────────────────────────────────

model Account {
  id               String        @id @default(cuid())
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id])
  name             String
  type             AccountType
  isPartnerCapital Boolean       @default(false)
  updatedBy        String?
  archivedAt       DateTime?
  archivedBy       String?
  lines            JournalLine[]
}

model Partner {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  name         String
  email        String?
  role         String?
  ownershipPct Decimal?      @db.Decimal(5, 2)
  notes        String?
  updatedAt    DateTime      @updatedAt
  updatedBy    String?
  archivedAt   DateTime?
  archivedBy   String?
  lines        JournalLine[]
}

model JournalEntry {
  id         String        @id @default(cuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id])
  date       DateTime      @db.Date
  memo       String
  reference  String?
  isReversal Boolean       @default(false)
  reversesId String?
  createdBy  String
  createdAt  DateTime      @default(now())
  lines      JournalLine[]
}

model JournalLine {
  id        String       @id @default(cuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id])
  accountId String
  account   Account      @relation(fields: [accountId], references: [id])
  partnerId String?
  partner   Partner?     @relation(fields: [partnerId], references: [id])
  debit     Decimal      @default(0) @db.Decimal(14, 2)
  credit    Decimal      @default(0) @db.Decimal(14, 2)
}

// ─── Audit & Settings ────────────────────────────────────────────────────────

/// Append-only audit trail. Never updated or deleted.
model AuditLog {
  id         String      @id @default(cuid())
  companyId  String
  projectId  String?
  project    Project?    @relation(fields: [projectId], references: [id])
  entityType EntityType
  entityId   String
  action     AuditAction
  /// JSON array of {field, oldValue, newValue}
  changes    String      @default("[]")
  /// Required for financial/schedule-critical changes
  reason     String?
  userId     String
  userName   String
  createdAt  DateTime    @default(now())

  @@index([projectId, entityType, createdAt])
  @@index([entityId])
  @@index([userId])
}

// ─── Estimates ───────────────────────────────────────────────────────────────

/// Company-level reusable estimate template (e.g. "Addition", "Remodel").
model EstimateTemplate {
  id          String                     @id @default(cuid())
  companyId   String
  company     Company                    @relation(fields: [companyId], references: [id])
  name        String
  description String?
  sortOrder   Int                        @default(0)
  createdBy   String
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  updatedBy   String?
  archivedAt  DateTime?
  archivedBy  String?
  divisions   EstimateTemplateDivision[]
  estimates   ProjectEstimate[]

  @@index([companyId])
}

model EstimateTemplateDivision {
  id         String                  @id @default(cuid())
  templateId String
  template   EstimateTemplate        @relation(fields: [templateId], references: [id])
  csiCode    String?
  name       String
  sortOrder  Int                     @default(0)
  archivedAt DateTime?
  archivedBy String?
  groups     EstimateTemplateGroup[]
  items      EstimateTemplateItem[]

  @@index([templateId])
}

model EstimateTemplateGroup {
  id         String                   @id @default(cuid())
  divisionId String
  division   EstimateTemplateDivision @relation(fields: [divisionId], references: [id])
  name       String
  sortOrder  Int                      @default(0)
  archivedAt DateTime?
  archivedBy String?
  items      EstimateTemplateItem[]

  @@index([divisionId])
}

model EstimateTemplateItem {
  id                  String                   @id @default(cuid())
  divisionId          String
  division            EstimateTemplateDivision @relation(fields: [divisionId], references: [id])
  groupId             String?
  group               EstimateTemplateGroup?   @relation(fields: [groupId], references: [id])
  name                String
  unit                String?
  defaultQty          Decimal?                 @db.Decimal(14, 4)
  defaultUnitCost     Decimal?                 @db.Decimal(14, 2)
  defaultLaborCost    Decimal?                 @db.Decimal(14, 2)
  defaultMaterialCost Decimal?                 @db.Decimal(14, 2)
  defaultMarkupPct    Decimal?                 @db.Decimal(5, 2)
  notes               String?
  visibleInPdf        Boolean                  @default(true)
  sortOrder           Int                      @default(0)
  archivedAt          DateTime?
  archivedBy          String?

  @@index([divisionId])
  @@index([groupId])
}

/// Project-specific estimate, cloned from a template or created from scratch.
model ProjectEstimate {
  id          String                    @id @default(cuid())
  projectId   String
  project     Project                   @relation(fields: [projectId], references: [id])
  templateId  String?
  template    EstimateTemplate?         @relation(fields: [templateId], references: [id])
  name        String
  description String?
  status      String                    @default("DRAFT")
  createdBy   String
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  updatedBy   String?
  archivedAt  DateTime?
  archivedBy  String?
  divisions   ProjectEstimateDivision[]

  @@index([projectId])
}

model ProjectEstimateDivision {
  id          String                  @id @default(cuid())
  estimateId  String
  estimate    ProjectEstimate         @relation(fields: [estimateId], references: [id])
  csiCode     String?
  name        String
  sortOrder   Int                     @default(0)
  archivedAt  DateTime?
  archivedBy  String?
  groups      ProjectEstimateGroup[]
  items       ProjectEstimateItem[]

  @@index([estimateId])
}

model ProjectEstimateGroup {
  id          String                  @id @default(cuid())
  divisionId  String
  division    ProjectEstimateDivision @relation(fields: [divisionId], references: [id])
  name        String
  sortOrder   Int                     @default(0)
  archivedAt  DateTime?
  archivedBy  String?
  items       ProjectEstimateItem[]

  @@index([divisionId])
}

model ProjectEstimateItem {
  id           String                  @id @default(cuid())
  divisionId   String
  division     ProjectEstimateDivision @relation(fields: [divisionId], references: [id])
  groupId      String?
  group        ProjectEstimateGroup?   @relation(fields: [groupId], references: [id])
  name         String
  unit         String?
  qty          Decimal                 @default(1)  @db.Decimal(14, 4)
  unitCost     Decimal                 @default(0)  @db.Decimal(14, 2)
  laborCost    Decimal                 @default(0)  @db.Decimal(14, 2)
  materialCost Decimal                 @default(0)  @db.Decimal(14, 2)
  markupPct    Decimal                 @default(0)  @db.Decimal(5, 2)
  manualTotal  Decimal?                @db.Decimal(14, 2)
  vendor       String?
  notes        String?
  visibleInPdf Boolean                 @default(true)
  sortOrder    Int                     @default(0)
  archivedAt   DateTime?
  archivedBy   String?

  @@index([divisionId])
  @@index([groupId])
}

/// Per-project key-value settings (KPI assumptions, widget config, alert thresholds).
model ProjectSettings {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  key       String
  value     String
  updatedBy String
  updatedAt DateTime @updatedAt

  @@unique([projectId, key])
}
