generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  PM
  BOOKKEEPER
  PARTNER
  CLIENT
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  EXPENSE
  REVENUE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  RESTORE
  IMPORT
  REVERSE
}

enum EntityType {
  EXPENSE
  COST_CODE
  TASK
  JOURNAL_ENTRY
  PARTNER
  ACCOUNT
  USER
  PROJECT
  PROJECT_SETTINGS
  ESTIMATE_TEMPLATE
  PROJECT_ESTIMATE
}

// ─── Core ────────────────────────────────────────────────────────────────────

model Company {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  createdAt         DateTime           @default(now())
  projects          Project[]
  users             User[]
  partners          Partner[]
  estimateTemplates EstimateTemplate[]
  clients           Client[]
  dailySummaries    DailySummary[]
  payees            Payee[]
  termsTemplates    TermsTemplate[]
  leads             Lead[]
  leadsLastSyncedAt DateTime?
  pipelineCards        PipelineCard[]
  requestTrackerUrl    String?
  requestTrackerDate   String?
  backupFileUrl        String?
  backupFileDate       String?
  invoices          Invoice[]
  changeOrders      ChangeOrder[]
  subContractors    SubContractor[]
  payApps           PayApp[]
  dailyLogs         DailyLog[]
  clientMessages    ClientMessage[]
  googleRefreshToken String?
  scopesOfWork      ScopeOfWork[]
  coverNames        Json?          // { [blobUrl]: string }
  address           String?
  phone             String?
  email             String?
  licenses          String?
  tagline           String?
  logoUrl           String?
  website           String?
  contactName       String?
}

model ScopeOfWork {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Lead {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String?
  email        String?
  phone        String?
  address      String?
  city         String?
  state        String?
  zip          String?
  projectType  String?
  message      String?
  source       String   @default("email")
  gmailMsgId    String?  @unique
  linkedMsgIds  String?  // space-separated additional Gmail msg IDs for dedup
  emailFrom     String?
  emailSubject  String?
  receivedAt    DateTime @default(now())
  status        String   @default("NEW")
  pipelineCard  PipelineCard?
  notes         Note[]
  followUps     FollowUp[]
  subBids       SubBid[]

  @@index([companyId])
  @@index([receivedAt])
}

model TermsTemplate {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  content   String
  createdAt DateTime @default(now())

  @@index([companyId])
}

model Payee {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  createdAt DateTime @default(now())

  @@unique([companyId, name])
  @@index([companyId])
}

model Client {
  id        String            @id @default(cuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id])
  name      String
  address   String?
  city      String?
  state     String?
  zip       String?
  email     String?
  emailList Json?             // string[] — all email addresses
  phone     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  coverPhotoType String?   // "FLAT_ROOFS" | "ADDITIONS" | "CUSTOM"
  coverPhotoUrl  String?   // Vercel Blob URL for CUSTOM uploads
  coverTitle     String?   // Custom title shown on PDF cover page
  isCommercial      Boolean   @default(false)
  status            String    @default("PROSPECT") // "PROSPECT" | "ACTIVE"
  sortOrder         Int       @default(0)
  projectName              String?   // Project name used in filenames and PDF labels
  legalDescription         String?   // Property legal description for lien releases
  dailyLogEmailEnabled     Boolean   @default(false)
  portalShowMessages       Boolean   @default(true)
  portalShowDailyPhotos    Boolean   @default(true)
  portalShowDocuments      Boolean   @default(true)
  portalShowDailyLogs      Boolean   @default(true)
  templates      EstimateTemplate[]
  subBids        SubBid[]
  files          ClientFile[]
  documents      ClientDocument[]
  lienReleases   LienRelease[]
  notes          ClientNote[]
  leadNotes      Note[]
  followUps      FollowUp[]
  pipelineCards  PipelineCard[]
  invoices       Invoice[]
  changeOrders   ChangeOrder[]
  clientTasks    ClientTask[]
  emails         ClientEmail[]
  subAssignments    SubAssignment[]
  clientSubs        ClientSub[]
  materialPurchases MaterialPurchase[]
  portalUser        User?              @relation("PortalUser")
  portalPhotos      ClientPortalPhoto[]
  portalDocs        ClientPortalDocument[]
  payApps           PayApp[]
  dailyLogs         DailyLog[]
  messages          ClientMessage[]
}

model ClientMessage {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  content     String    @db.Text
  attachments String?   @db.Text   // JSON: [{id,name,url,mimeType}]
  senderType  String               // "CONTRACTOR" | "CLIENT"
  senderName  String
  readByClient     Boolean  @default(false)
  readByContractor Boolean  @default(false)
  reminderSent     Boolean  @default(false)
  replyToId        String?
  createdAt   DateTime  @default(now())
  @@index([clientId])
  @@index([companyId])
}

model ClientSub {
  id              String         @id @default(cuid())
  companyId       String
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subContractorId String?
  subContractor   SubContractor? @relation(fields: [subContractorId], references: [id], onDelete: SetNull)
  subName         String?
  scope           String?
  division        String?
  contractAmount  Decimal        @default(0) @db.Decimal(14, 2)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  payments        SubPayment[]
  scopeItems      SubScopeItem[]
  @@index([clientId])
  @@index([companyId])
}

model SubScopeItem {
  id          String    @id @default(cuid())
  companyId   String
  clientSubId String
  clientSub   ClientSub @relation(fields: [clientSubId], references: [id], onDelete: Cascade)
  csiCode     String?
  name        String
  salePrice   Decimal?  @db.Decimal(14, 2)
  amount      Decimal   @default(0) @db.Decimal(14, 2)
  createdAt   DateTime  @default(now())
  @@index([clientSubId])
}

model SubPayment {
  id          String    @id @default(cuid())
  companyId   String
  clientSubId String
  clientSub   ClientSub @relation(fields: [clientSubId], references: [id], onDelete: Cascade)
  amount      Decimal   @db.Decimal(14, 2)
  method      String
  paidAt      DateTime
  checkNumber String?
  notes       String?
  createdAt   DateTime  @default(now())
  @@index([clientSubId])
  @@index([companyId])
}

model Supplier {
  id        String             @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime           @default(now())
  purchases MaterialPurchase[]
  @@index([companyId])
}

model MaterialPurchase {
  id          String   @id @default(cuid())
  companyId   String
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(14, 2)
  description String?
  purchasedAt DateTime
  notes       String?
  createdAt   DateTime @default(now())
  @@index([clientId])
  @@index([companyId])
}

model ClientPortalPhoto {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  companyId  String
  caption    String?
  fileUrl    String
  fileName   String
  fileSize   Int      @default(0)
  sortOrder  Int      @default(0)
  uploadedAt DateTime @default(now())

  @@index([clientId])
  @@index([companyId])
}

model ClientPortalDocument {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  companyId  String
  category   String   // "PERMIT_CARD" | "PERMIT_APPLICATION" | "NOC" | "OTHER"
  label      String
  fileUrl    String
  fileName   String
  fileSize   Int      @default(0)
  uploadedAt DateTime @default(now())

  @@index([clientId])
  @@index([companyId])
}

model ClientFile {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  companyId  String
  fileName       String
  fileUrl        String
  fileSize       Int
  mimeType       String?
  uploadedAt     DateTime @default(now())
  uploadedBy     String?
  useInEstimate  Boolean  @default(false)
  clientVisible    Boolean @default(false)
  sourceMessageId  String?

  @@index([clientId])
}

model ClientDocument {
  id                   String    @id @default(cuid())
  clientId             String
  client               Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  companyId            String
  name                 String
  description          String?
  originalFileUrl      String
  signatureToken       String?   @unique
  clientAlreadySigned  Boolean   @default(false)
  clientSignedAt       DateTime?
  clientSignatureData  String?
  clientSignedByName   String?
  emailOpenedAt        DateTime?
  counterSignedAt         DateTime?
  counterSignatureData    String?
  countersignedFileUrl    String?
  executedEmailSentAt     DateTime?
  createdAt               DateTime  @default(now())
  createdBy            String?
  archivedAt           DateTime?

  @@index([clientId])
  @@index([companyId])
}

model LienRelease {
  id               String    @id @default(cuid())
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  companyId        String
  type             String    // "PARTIAL" | "FINAL"
  subName          String    // lienor / subcontractor releasing the lien
  recipientEmail   String?
  amount           String?   // dollar consideration (stored as text)
  throughDate      String?   // YYYY-MM-DD
  legalDescription String
  signatureToken   String?   @unique
  signedAt         DateTime?
  signatureData    String?
  signedByName     String?
  emailSentAt      DateTime?
  createdAt        DateTime  @default(now())
  archivedAt       DateTime?

  @@index([clientId])
  @@index([companyId])
}

model ClientNote {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  companyId     String
  transcription  String?
  audioUrl       String?
  audioMimeType  String?
  audioSize      Int?
  createdAt      DateTime @default(now())
  createdBy      String?

  @@index([clientId])
}

model ScheduleSavedTemplate {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  tasks       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

model ClientEmail {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  companyId String
  fromEmail String
  to        String
  cc        String?
  bcc       String?
  subject   String
  body      String
  sentAt    DateTime @default(now())
  sentBy      String?
  context     String?   // e.g. "estimate", "invoice", "manual"
  attachments String?   // JSON array of filenames e.g. ["Estimate-2647.pdf"]

  @@index([clientId])
  @@index([companyId])
}

model FollowUp {
  id            String           @id @default(cuid())
  companyId     String
  category      FollowUpCategory @default(TASK)
  text          String
  audioUrl      String?
  audioMimeType String?
  audioSize     Int?
  clientId      String?
  client        Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadId        String?
  lead          Lead?            @relation(fields: [leadId], references: [id], onDelete: SetNull)
  dueDate               DateTime?        @db.Date
  completedAt           DateTime?
  googleCalendarEventId String?
  createdAt             DateTime         @default(now())
  createdBy             String?

  @@index([companyId, category])
}

enum FollowUpCategory {
  TASK
  FOLLOW_UP
  ESTIMATE
}

model SubBid {
  id             String   @id @default(cuid())
  clientId       String?
  client         Client?  @relation(fields: [clientId], references: [id])
  leadId         String?
  lead           Lead?    @relation(fields: [leadId], references: [id])
  projectId      String?
  project        Project? @relation(fields: [projectId], references: [id])
  companyId      String
  divisionCode   String
  divisionName   String
  contractorName String?
  amount         Decimal? @db.Decimal(14, 2)
  notes          String?
  fileUrl        String?
  fileName       String?
  status         String   @default("MISSING")
  isPlaceholder  Boolean  @default(false)
  emailSource    String?
  sourceLabel    String?
  bidDate        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([clientId])
  @@index([leadId])
  @@index([projectId])
  @@index([clientId, divisionCode])
  @@index([companyId])
}

model Project {
  id             String               @id @default(cuid())
  companyId      String
  company        Company              @relation(fields: [companyId], references: [id])
  name           String
  code           String?
  address        String?
  city           String?
  state          String?
  zip            String?
  startDate      DateTime
  budget         Decimal              @db.Decimal(14, 2)
  status         String               @default("ACTIVE")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  updatedBy      String?
  expenses       Expense[]
  costCodes      CostCode[]
  tasks          Task[]
  accounts       Account[]
  journalEntries JournalEntry[]
  auditLogs      AuditLog[]
  settings       ProjectSettings[]
  estimates      ProjectEstimate[]
  userAccess          UserProjectAccess[]
  llcBeginningBalance Decimal             @default(0) @db.Decimal(14, 2)
  llcName             String?
  photoUrl            String?
  sortOrder           Int                 @default(0)
  partnerAccountEntries PartnerAccountEntry[]
  partners              Partner[]
  subBids               SubBid[]
}

model User {
  id             String               @id @default(cuid())
  companyId      String
  company        Company              @relation(fields: [companyId], references: [id])
  email          String               @unique
  name           String
  lastName       String?
  role           Role                 @default(PM)
  passwordHash   String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  updatedBy      String?
  archivedAt     DateTime?
  archivedBy     String?
  projectAccess  UserProjectAccess[]
  clientId       String?              @unique
  clientLink     Client?              @relation("PortalUser", fields: [clientId], references: [id], onDelete: SetNull)
  passwordResetToken PasswordResetToken?
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  userId  String   @unique
  token   String   @unique
  expires DateTime
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProjectAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

// ─── Expenses ────────────────────────────────────────────────────────────────

model CostCode {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id])
  code         String
  name         String
  budgetAmount Decimal   @default(0) @db.Decimal(14, 2)
  expenses     Expense[]
  updatedAt    DateTime  @updatedAt
  updatedBy    String?
  archivedAt   DateTime?
  archivedBy   String?

  @@unique([projectId, code])
}

model Expense {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  companyId     String
  date          DateTime  @db.Date
  vendor        String
  description   String
  costCodeId    String?
  costCode      CostCode? @relation(fields: [costCodeId], references: [id])
  category      String
  amount        Decimal   @db.Decimal(14, 2)
  tax           Decimal   @default(0) @db.Decimal(14, 2)
  paymentMethod String
  paidBy        String
  receiptUrl    String?
  receiptHash   String?
  notes         String?
  isPossibleDup Boolean   @default(false)
  isDuplicate   Boolean   @default(false)
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  updatedBy     String?
  archivedAt    DateTime?
  archivedBy    String?
}

// ─── Schedule ─────────────────────────────────────────────────────────────────

model Task {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id])
  phase           String
  name            String
  durationDays    Int
  startDate       DateTime?       @db.Date
  endDate         DateTime?       @db.Date
  predecessorIds  String[]
  trade           String?
  assignee        String?
  isMilestone     Boolean         @default(false)
  status          TaskStatus      @default(NOT_STARTED)
  percentComplete Int             @default(0)
  notes           String?
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  updatedBy       String?
  archivedAt      DateTime?
  archivedBy      String?
  changeLogs      TaskChangeLog[]
}

model TaskChangeLog {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  field     String
  oldValue  String?
  newValue  String?
  changedBy String
  changedAt DateTime @default(now())
}

// ─── Client Schedule ──────────────────────────────────────────────────────────

model ClientTask {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  companyId       String
  phase           String    @default("General")
  name            String
  durationDays    Int       @default(1)
  startDate       DateTime? @db.Date
  endDate         DateTime? @db.Date
  predecessorIds  String[]
  predecessors    Json?     // [{id, type: "FS"|"SS"|"FF"|"SF", lag: number}]
  parentId        String?   // parent task id for sub-task hierarchy
  trade           String?
  assignee        String?
  isMilestone     Boolean   @default(false)
  status          String    @default("NOT_STARTED")
  percentComplete Int       @default(0)
  notes           String?
  priority        String?
  actualFinish    DateTime? @db.Date
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clientId])
  @@index([companyId])
}

// ─── Ledger ──────────────────────────────────────────────────────────────────

model Account {
  id               String        @id @default(cuid())
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id])
  name             String
  type             AccountType
  isPartnerCapital Boolean       @default(false)
  updatedBy        String?
  archivedAt       DateTime?
  archivedBy       String?
  lines            JournalLine[]
}

model Partner {
  id                   String               @id @default(cuid())
  companyId            String
  company              Company              @relation(fields: [companyId], references: [id])
  projectId            String?
  project              Project?             @relation(fields: [projectId], references: [id])
  name                 String
  email                String?
  role                 String?
  ownershipPct         Decimal?             @db.Decimal(5, 2)
  notes                String?
  beginningBalance     Decimal              @default(0) @db.Decimal(14, 2)
  updatedAt            DateTime             @updatedAt
  updatedBy            String?
  archivedAt           DateTime?
  archivedBy           String?
  lines                JournalLine[]
  accountEntries       PartnerAccountEntry[]
}

model PartnerAccountEntry {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  accountType String   // "PARTNER" or "LLC"
  partnerId   String?
  partner     Partner? @relation(fields: [partnerId], references: [id])
  description String
  amount      Decimal  @db.Decimal(14, 2)
  entryType   String   // "CREDIT" or "DEBIT"
  method      String?  // "Check" | "ACH" | "Wire" | "Zelle" | "Credit Card" | "Cash" | "Other"
  date          DateTime @db.Date
  createdAt     DateTime @default(now())
  createdBy     String
  linkedEntryId String?

  @@index([projectId])
  @@index([partnerId])
}

model JournalEntry {
  id         String        @id @default(cuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id])
  date       DateTime      @db.Date
  memo       String
  reference  String?
  isReversal Boolean       @default(false)
  reversesId String?
  createdBy  String
  createdAt  DateTime      @default(now())
  lines      JournalLine[]
}

model JournalLine {
  id        String       @id @default(cuid())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id])
  accountId String
  account   Account      @relation(fields: [accountId], references: [id])
  partnerId String?
  partner   Partner?     @relation(fields: [partnerId], references: [id])
  debit     Decimal      @default(0) @db.Decimal(14, 2)
  credit    Decimal      @default(0) @db.Decimal(14, 2)
}

// ─── Audit & Settings ────────────────────────────────────────────────────────

/// Append-only audit trail. Never updated or deleted.
model AuditLog {
  id         String      @id @default(cuid())
  companyId  String
  projectId  String?
  project    Project?    @relation(fields: [projectId], references: [id])
  entityType EntityType
  entityId   String
  action     AuditAction
  /// JSON array of {field, oldValue, newValue}
  changes    String      @default("[]")
  /// Required for financial/schedule-critical changes
  reason     String?
  userId     String
  userName   String
  createdAt  DateTime    @default(now())

  @@index([projectId, entityType, createdAt])
  @@index([entityId])
  @@index([userId])
}

// ─── Estimates ───────────────────────────────────────────────────────────────

/// Company-level reusable estimate template (e.g. "Addition", "Remodel").
model EstimateTemplate {
  id          String                     @id @default(cuid())
  companyId   String
  company     Company                    @relation(fields: [companyId], references: [id])
  clientId    String?
  client      Client?                    @relation(fields: [clientId], references: [id])
  name        String
  description String?
  sortOrder   Int                        @default(0)
  createdBy   String
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  updatedBy   String?
  archivedAt  DateTime?
  archivedBy  String?
  type            String                     @default("TEMPLATE")
  estimateNumber  String?
  estimateDate    String?
  paymentSchedule Json?
  showTerms       Boolean                    @default(false)
  termsContent    String?
  gcFeePercent    Decimal?                   @db.Decimal(5, 2)
  sqFt            Decimal?                   @db.Decimal(10, 2)
  durationMonths  Decimal?                   @db.Decimal(5, 2)
  summaryGroups   Json?
  signatureToken         String?   @unique
  signatureData          String?
  signedAt               DateTime?
  signedByName           String?
  lastSentAt             DateTime?
  emailOpenedAt          DateTime?
  counterSignatureData   String?
  counterSignedAt        DateTime?
  executedPdfUrl         String?
  executedEmailSentAt    DateTime?
  hasSkylights           Boolean                    @default(true)
  hasRoofDrains          Boolean                    @default(true)
  internalProfitOverride Decimal?                   @db.Decimal(12, 2) // Manual lump-sum internal profit (overrides auto markup sum)
  insulationType         String?                    @default("ISO")
  combinationType        String?
  brandingName           String?
  divisions       EstimateTemplateDivision[]
  estimates   ProjectEstimate[]
  invoices    Invoice[]
  versions    EstimateVersion[]

  @@index([companyId])
}

model EstimateVersion {
  id          String   @id @default(cuid())
  companyId   String
  clientId    String
  templateId  String
  template    EstimateTemplate @relation(fields: [templateId], references: [id])
  label       String
  total       Decimal  @db.Decimal(12, 2)
  subtotal    Decimal  @db.Decimal(12, 2)
  gcFee       Decimal  @db.Decimal(12, 2)
  snapshot    Json?    // full division/item breakdown at save time
  createdAt   DateTime @default(now())
  createdBy   String?

  @@index([templateId])
  @@index([clientId])
  @@index([companyId])
}

model EstimateTemplateDivision {
  id          String                  @id @default(cuid())
  templateId  String
  template    EstimateTemplate        @relation(fields: [templateId], references: [id])
  csiCode     String?
  name        String
  manualTotal Decimal?                @db.Decimal(14, 2)
  sortOrder   Int                     @default(0)
  archivedAt  DateTime?
  archivedBy  String?
  groups      EstimateTemplateGroup[]
  items       EstimateTemplateItem[]

  @@index([templateId])
}

model EstimateTemplateGroup {
  id         String                   @id @default(cuid())
  divisionId String
  division   EstimateTemplateDivision @relation(fields: [divisionId], references: [id])
  name       String
  sortOrder  Int                      @default(0)
  archivedAt DateTime?
  archivedBy String?
  items      EstimateTemplateItem[]

  @@index([divisionId])
}

model EstimateTemplateItem {
  id                  String                   @id @default(cuid())
  divisionId          String
  division            EstimateTemplateDivision @relation(fields: [divisionId], references: [id])
  groupId             String?
  group               EstimateTemplateGroup?   @relation(fields: [groupId], references: [id])
  name                String
  csiCode             String?
  detail              String?
  unit                String?
  defaultQty          Decimal?                 @db.Decimal(14, 4)
  defaultUnitCost     Decimal?                 @db.Decimal(14, 2)
  defaultLaborCost    Decimal?                 @db.Decimal(14, 2)
  defaultMaterialCost Decimal?                 @db.Decimal(14, 2)
  defaultMarkupPct    Decimal?                 @db.Decimal(5, 2)
  notes               String?
  visibleInPdf        Boolean                  @default(true)
  sortOrder           Int                      @default(0)
  archivedAt          DateTime?
  archivedBy          String?

  @@index([divisionId])
  @@index([groupId])
}

/// Project-specific estimate, cloned from a template or created from scratch.
model ProjectEstimate {
  id           String                    @id @default(cuid())
  projectId    String
  project      Project                   @relation(fields: [projectId], references: [id])
  templateId   String?
  template     EstimateTemplate?         @relation(fields: [templateId], references: [id])
  name         String
  description  String?
  status       String                    @default("DRAFT")
  gcFeePercent   Decimal?                  @db.Decimal(5, 2)
  sqFt           Decimal?                  @db.Decimal(10, 2)
  durationMonths Decimal?                  @db.Decimal(5, 2)
  summaryGroups  Json?
  createdBy   String
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  updatedBy   String?
  archivedAt  DateTime?
  archivedBy  String?
  divisions   ProjectEstimateDivision[]

  @@index([projectId])
}

model ProjectEstimateDivision {
  id          String                  @id @default(cuid())
  estimateId  String
  estimate    ProjectEstimate         @relation(fields: [estimateId], references: [id])
  csiCode     String?
  name        String
  manualTotal Decimal?                @db.Decimal(14, 2)
  sortOrder   Int                     @default(0)
  archivedAt  DateTime?
  archivedBy  String?
  groups      ProjectEstimateGroup[]
  items       ProjectEstimateItem[]

  @@index([estimateId])
}

model ProjectEstimateGroup {
  id          String                  @id @default(cuid())
  divisionId  String
  division    ProjectEstimateDivision @relation(fields: [divisionId], references: [id])
  name        String
  sortOrder   Int                     @default(0)
  archivedAt  DateTime?
  archivedBy  String?
  items       ProjectEstimateItem[]

  @@index([divisionId])
}

model ProjectEstimateItem {
  id           String                  @id @default(cuid())
  divisionId   String
  division     ProjectEstimateDivision @relation(fields: [divisionId], references: [id])
  groupId      String?
  group        ProjectEstimateGroup?   @relation(fields: [groupId], references: [id])
  name         String
  csiCode      String?
  detail       String?
  unit         String?
  qty          Decimal                 @default(1)  @db.Decimal(14, 4)
  unitCost     Decimal                 @default(0)  @db.Decimal(14, 2)
  laborCost    Decimal                 @default(0)  @db.Decimal(14, 2)
  materialCost Decimal                 @default(0)  @db.Decimal(14, 2)
  markupPct    Decimal                 @default(0)  @db.Decimal(5, 2)
  manualTotal  Decimal?                @db.Decimal(14, 2)
  vendor       String?
  notes        String?
  visibleInPdf Boolean                 @default(true)
  sortOrder    Int                     @default(0)
  archivedAt   DateTime?
  archivedBy   String?

  @@index([divisionId])
  @@index([groupId])
}

/// Per-project key-value settings (KPI assumptions, widget config, alert thresholds).
model ProjectSettings {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  key       String
  value     String
  updatedBy String
  updatedAt DateTime @updatedAt

  @@unique([projectId, key])
}

// ─── AI Memory ───────────────────────────────────────────────────────────────

model DailySummary {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  date      DateTime @db.Date
  content   String
  createdAt DateTime @default(now())

  @@unique([companyId, date])
  @@index([companyId, date])
}

// ─── Pipeline ─────────────────────────────────────────────────────────────────

model PipelineCard {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  clientId       String?
  client         Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadId         String?  @unique
  lead           Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  displayName    String   // name to show (fallback if no client/lead linked)
  stage          String   @default("NEW_LEAD")
  source         String?  // Evolute, ADU Elite, NSA, FYRD UP, etc.
  estimateValue  Decimal? @db.Decimal(12, 2)
  notes          String?
  pipelineType   String    @default("sales")
  sortOrder      Int       @default(0)
  stageChangedAt DateTime? // set when stage changes; null for legacy cards (use createdAt)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId, stage])
  @@index([companyId, pipelineType])
}

model Note {
  id        String   @id @default(cuid())
  companyId String
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  content   String
  noteDate  DateTime @default(now())
  createdAt DateTime @default(now())
  createdBy String?

  @@index([leadId])
  @@index([clientId])
  @@index([companyId])
}

// ─── Invoices ─────────────────────────────────────────────────────────────────

model Invoice {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  estimateId    String
  estimate      EstimateTemplate @relation(fields: [estimateId], references: [id])
  invoiceNumber String          // e.g. "2641-1"
  phase         String          // Payment phase name, e.g. "Deposit"
  trigger       String?         // Milestone description
  pct           Float           // Percentage
  amount        Float           // Dollar amount
  status        String  @default("DRAFT") // DRAFT | SENT | PAID
  dueDate       DateTime?
  notes         String?
  sentAt        DateTime?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payments      Payment[]
  lines         InvoiceLine[]

  @@index([companyId])
  @@index([clientId])
  @@index([estimateId])
}

model InvoiceLine {
  id               String   @id @default(cuid())
  invoiceId        String
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  estimateItemId   String?
  sortOrder        Int      @default(0)
  itemNumber       String   @default("")
  description      String   @default("")
  scheduledValue   Decimal  @default(0) @db.Decimal(15, 2)
  fromPrevious     Decimal  @default(0) @db.Decimal(15, 2)
  pctThisInvoice   Decimal  @default(0) @db.Decimal(7, 4)
  thisInvoice      Decimal  @default(0) @db.Decimal(15, 2)
  createdAt        DateTime @default(now())

  @@index([invoiceId])
  @@index([estimateItemId])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  companyId String
  amount    Float
  method    String   // "Cash" | "Check" | "Zelle" | "Credit Card" | "ACH" | "Wire"
  paidDate  DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([companyId])
}

// ─── Change Orders ─────────────────────────────────────────────────────────────

model ChangeOrder {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id])
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title         String
  orderNumber   String?
  status        String            @default("DRAFT") // DRAFT | SENT | APPROVED | REJECTED
  notes         String?
  signatureToken String?          @unique
  signatureData String?           @db.Text
  signedAt      DateTime?
  signedByName  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  items         ChangeOrderItem[]

  @@index([companyId])
  @@index([clientId])
}

model ChangeOrderItem {
  id            String      @id @default(cuid())
  changeOrderId String
  changeOrder   ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  sortOrder     Int         @default(0)
  csiCode       String?
  divisionName  String
  name          String
  description   String?
  qty           Decimal?
  unit          String?
  unitCost      Decimal?
  markupPct     Decimal?
  createdAt     DateTime    @default(now())

  @@index([changeOrderId])
}

// ─── Sub Contractor Database ──────────────────────────────────────────────────

model SubContractor {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  contactName   String?
  address       String?
  email         String?
  emailList     Json?    // string[] — all email addresses
  phone         String?
  licenseNumber String?
  isFavorite    Boolean  @default(false)
  divisionCode  String
  divisionName  String
  notes         String?
  source        String   @default("manual") // "sheet" | "bid" | "manual"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subAssignments SubAssignment[]
  clientSubs     ClientSub[]

  @@index([companyId])
  @@index([companyId, divisionCode])
  @@index([companyId, source])
}

// ─── Payment Applications (AIA G702 / G703) ───────────────────────────────────

model PayApp {
  id                   String       @id @default(cuid())
  companyId            String
  clientId             String
  payAppNumber         Int
  invoiceNumber        String?
  projectName          String?
  projectNumber        String?
  invoiceDate          String?
  paymentDue           String?
  periodStart          String?
  periodEnd            String?
  fromName             String?
  fromContact          String?
  fromAddress          String?
  toName               String?
  toContact            String?
  toAddress            String?
  originalContractSum  Decimal      @default(0) @db.Decimal(15, 2)
  lessPreviousInvoices Decimal      @default(0) @db.Decimal(15, 2)
  depositPriorBalance  Decimal      @default(0) @db.Decimal(15, 2)
  depositReductionThis Decimal      @default(0) @db.Decimal(15, 2)
  coAdditionsPrev      Decimal      @default(0) @db.Decimal(15, 2)
  coDeductionsPrev     Decimal      @default(0) @db.Decimal(15, 2)
  coAdditionsThis      Decimal      @default(0) @db.Decimal(15, 2)
  coDeductionsThis     Decimal      @default(0) @db.Decimal(15, 2)
  gcFeeScheduledValue  Decimal      @default(0) @db.Decimal(15, 2)
  isDepositInvoice     Boolean      @default(false)
  depositPct           Decimal      @default(0) @db.Decimal(5, 2)
  distributeOwner      Boolean      @default(true)
  distributeArchitect  Boolean      @default(false)
  distributeContractor Boolean      @default(false)
  certifiedBy          String?
  certState            String?
  certCounty           String?
  notaryName           String?
  archivedAt           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  lines                PayAppLine[]
  client               Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  company              Company      @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([clientId])
}

model PayAppLine {
  id             String   @id @default(cuid())
  payAppId       String
  sortOrder      Int      @default(0)
  itemNumber     String   @default("")
  description    String   @default("")
  scheduledValue Decimal  @default(0) @db.Decimal(15, 2)
  fromPrevious   Decimal  @default(0) @db.Decimal(15, 2)
  thisInvoice      Decimal  @default(0) @db.Decimal(15, 2)
  pctThisInvoice   Decimal  @default(0) @db.Decimal(7, 4)
  retainageThis    Decimal  @default(0) @db.Decimal(15, 2)
  retainageTotal Decimal  @default(0) @db.Decimal(15, 2)
  createdAt      DateTime @default(now())
  payApp         PayApp   @relation(fields: [payAppId], references: [id], onDelete: Cascade)

  @@index([payAppId])
}

model SubAssignment {
  id              String         @id @default(cuid())
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  companyId       String
  templateId      String?
  divisionId      String?
  itemId          String?
  label           String
  subContractorId String?
  subContractor   SubContractor? @relation(fields: [subContractorId], references: [id], onDelete: SetNull)
  subName         String?
  cost            Decimal?       @db.Decimal(14, 2)
  salePrice       Decimal?       @db.Decimal(14, 2)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([clientId])
  @@index([companyId])
}

model DailyLog {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  arrivalDate           DateTime
  departureTime         String?
  status                String    @default("IN_PROGRESS")
  siteCondition         String?

  weatherCondition      String?
  temperature           String?
  weatherNote           String?
  weatherDelay          Boolean   @default(false)
  scheduleDelay         Boolean   @default(false)

  jobsiteConditionNotes String?
  tasksPerformed        String?

  employeesOnSite       String?
  visitorsOnSite        Boolean   @default(false)
  employeeWorkNotes     String?
  subsOnJobsite         String?   @db.Text

  materialNotes         String?
  materialDelivered     String?   @db.Text
  materialUsed          String?   @db.Text

  equipmentNotes        String?
  equipmentUsed         String?   @db.Text
  equipmentDelivered    String?   @db.Text

  projectNotes          String?   @db.Text
  inspections           String?   @db.Text
  safetyMeetings        String?   @db.Text

  siteAuditConducted    Boolean   @default(false)
  areasOfConcern        String?
  workCompletedPct      String?
  estimatedCompletion   String?
  groundConditions      String?
  crewsPresent          String?
  equipmentDamaged      String?
  equipmentDamageNotes  String?
  signatureData         String?   @db.Text
  attachments           String?   @db.Text

  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@index([clientId])
}
